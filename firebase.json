{
  "hosting": {
    "target": "site",
    "public": "dist",
    "ignore": [
      "**/.*"
    ],
    "trailingSlash": true,
    "cleanUrls": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=63072000; includeSubDomains; preload"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
          }
        ]
      },
      {
        "source": "**/*.@(html|xml|txt|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, s-maxage=600, must-revalidate"
          }
        ]
      },
      {
        "regex": "^/(.*/)?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, s-maxage=600, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, s-maxage=86400"
          }
        ]
      },
      {
        "source": "_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(woff2|woff|jpg|jpeg|png|webp|avif|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000, s-maxage=31536000"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/sitemap-index.xml",
        "destination": "/sitemap.xml",
        "type": 301
      },
      {
        "source": "/sitemap-0.xml",
        "destination": "/sitemap.xml",
        "type": 301
      }
    ]
  }
}
