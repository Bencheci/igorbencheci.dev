---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import EarlierCard from '../../components/EarlierCard.astro';
import Split from '../../components/Split.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const work = projects.filter((p) => p.data.kind === 'work');
const personal = projects.filter((p) => p.data.kind === 'personal');
const earlier = projects.filter((p) => p.data.kind === 'earlier');
const categories = [...new Set(projects.flatMap((p) => p.data.category))].sort();
const list = {
  '@type': 'ItemList', name: 'Projects',
  itemListElement: projects.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@id': new URL(`/projects/${p.id}/#work`, Astro.site).toString(), '@type': 'CreativeWork', name: p.data.title, url: new URL(`/projects/${p.id}/`, Astro.site).toString(), description: p.data.summary, keywords: p.data.stack.join(', '), creator: { '@id': `${Astro.site}#igor` } } })),
};
---
<Base title="Projects and case studies" og="projects" pageType="CollectionPage" description="Case studies: a fintech mobile app, AI agents and LLM products, secure payments, a headless edge platform and data engineering." schema={[list]}>
  <div class="wrap article">
    <p class="eyebrow">Work</p>
    <h1 class="fade-up"><Split text="Things I've built" /></h1>
    <p class="lead" data-reveal>Client work from Venture Tech, where I build for fintech and financial-education brands, plus my own experiments. Filter by technology.</p>

    <div class="filters" role="group" aria-label="Filter by technology" data-reveal>
      <button type="button" data-filter="" aria-pressed="true">All</button>
      {categories.map((c) => <button type="button" data-filter={c} aria-pressed="false">{c}</button>)}
    </div>

    <section data-group style="padding-top:1rem">
      <h2 class="sr-only">Client work</h2>
      <ul class="grid" data-filterable>{work.map((p, i) => <ProjectCard project={p} index={i} big={i === 0} />)}</ul>
    </section>
    {personal.length > 0 && (
      <section data-group>
        <div class="section-head" data-reveal><div><p class="eyebrow">Side projects</p><h2>Built for fun (and to learn)</h2></div></div>
        <ul class="grid" data-filterable>{personal.map((p, i) => <ProjectCard project={p} index={work.length + i} />)}</ul>
      </section>
    )}
    {earlier.length > 0 && (
      <section data-group id="razz-interactive" style="scroll-margin-top:6rem">
        <div class="section-head" data-reveal><div><p class="eyebrow">Earlier work · Razz Interactive, 2016–2019</p><h2>Award-recognized brand campaigns</h2></div></div>
        <p class="lead" data-reveal style="margin:-1rem 0 2rem;max-width:60ch">At a Miami digital agency I built campaign sites and tools for Universal Music Latino (J Balvin, Prince Royce, Victoria La Mala), Mountain Dew, Sprint and Pokémon GO, Lennar and Wood Partners, plus floor plan management tools for their properties.</p>
        <ul class="grid earlier" data-filterable>{earlier.map((p, i) => <EarlierCard project={p} index={i} />)}</ul>
      </section>
    )}
  </div>
</Base>
