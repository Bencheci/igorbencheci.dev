---
/**
 * End-of-post prompt: "Add igorbencheci.dev as a preferred source on Google".
 * Blog posts only: the feature affects Top Stories / AI answers, so it only matters for articles.
 */
import { SITE } from '../site';
const icon = '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/></svg>';
---
<aside class="pref-card" data-reveal>
  <div>
    <p class="pref-title">Prefer this site on Google</p>
    <p class="pref-text">Add igorbencheci.dev as a preferred source and new posts on AI, mobile and web performance show up more often in your Top Stories.</p>
  </div>
  <a class="pref-btn" href={SITE.googlePreferredSource} target="_blank" rel="noopener"><Fragment set:html={icon} />Add on Google</a>
</aside>
