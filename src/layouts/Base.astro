---
/**
 * Page shell: SEO head (canonical, Open Graph image per page, JSON-LD), sticky header, footer,
 * and the site-wide motion script. Pages pass `og` (an OG image key) and extra `schema` objects.
 */
import '../styles/global.css';
import { SITE } from '../site';
import { personSchema, id } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  og?: string;
  schema?: Record<string, unknown>[];
  publishedTime?: Date;
  /** schema.org page type for this URL (ProfilePage, ContactPage, CollectionPage, ...). */
  pageType?: string;
  /** Keep this URL out of search results (404, utility pages). */
  noindex?: boolean;
}
const { title, description = SITE.description, type = 'website', og = 'home', schema = [], publishedTime, pageType = 'WebPage', noindex = false } = Astro.props;
// Let Google show a large image preview and a full-length snippet for indexable pages.
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og/${og}.png`, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/projects/', label: 'Work' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
  { href: '/resume/', label: 'Resume' },
  { href: '/contact/', label: 'Contact' },
];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    ...personSchema(Astro.site),
    {
      '@type': 'WebSite', '@id': id(Astro.site, 'site'), url: Astro.site?.toString(), name: SITE.name,
      description: SITE.description, inLanguage: 'en-US',
      author: { '@id': id(Astro.site, 'igor') }, publisher: { '@id': id(Astro.site, 'igor') }, about: { '@id': id(Astro.site, 'igor') },
    },
    {
      '@type': pageType, '@id': `${canonical}#page`, url: canonical.toString(), name: fullTitle,
      description, isPartOf: { '@id': id(Astro.site, 'site') }, about: { '@id': id(Astro.site, 'igor') },
      primaryImageOfPage: ogImage.toString(), inLanguage: 'en-US',
      ...(pageType === 'ProfilePage' ? { mainEntity: { '@id': id(Astro.site, 'igor') } } : {}),
    },
    ...schema,
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Before first paint: mark JS on, and apply the saved theme (else the OS preference) so there's no flash.
      (function () {
        var d = document.documentElement; d.classList.add('js');
        var t; try { t = localStorage.getItem('theme'); } catch (e) {}
        d.dataset.theme = t === 'light' || t === 'dark' ? t : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="preload" href="/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <!-- Icons are versioned (?v=) so browsers drop the old cached mark; bump v when the artwork changes. -->
    <link rel="icon" href="/favicon.ico?v=3" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png?v=3" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} · Blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/json" title="Resume (JSON Resume)" href="/resume.json" />
    <link rel="alternate" type="text/plain" title="Profile for AI assistants" href="/llms.txt" />
    <meta name="theme-color" content="#07080c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f5f0" media="(prefers-color-scheme: light)" />
    <meta name="author" content={SITE.name} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? SITE.title} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={SITE.linkedin} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@IgorBencheci" />
    <meta name="twitter:creator" content="@IgorBencheci" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 64 64" width="26" height="26"><defs><linearGradient id="bm1" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#3de8ff"/><stop offset="1" stop-color="#2f7bff"/></linearGradient><linearGradient id="bm2" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#c46bff"/><stop offset="1" stop-color="#7a5cff"/></linearGradient></defs><path d="M14 54 29 10" stroke="url(#bm1)" stroke-width="12" stroke-linecap="round" fill="none"/><path d="M35 54 50 10" stroke="url(#bm2)" stroke-width="12" stroke-linecap="round" fill="none"/></svg></span><span class="brand-name">igorbencheci<span class="tld">.dev</span></span><span class="sr-only"> (Igor Bencheci, home)</span></a>
        <div class="header-end">
          <nav aria-label="Main" class="nav-desktop">
            <ul class="nav">
              {nav.map((n) => (
                <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
              ))}
            </ul>
          </nav>
          <ul class="header-socials" aria-label="Social profiles">
            <li><a href={SITE.linkedin} rel="me noopener" aria-label="Igor Bencheci on LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg></a></li>
            <li><a href={SITE.x} rel="me noopener" aria-label="Igor Bencheci on X"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.58-6.63 7.58H.48l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93zm-1.29 19.5h2.04L6.48 3.24H4.3l13.31 17.41z"/></svg></a></li>
            {SITE.github && <li><a href={SITE.github} rel="me noopener" aria-label="Igor Bencheci on GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6.1-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.7 1.6.2 2.9.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3"/></svg></a></li>}
          </ul>
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
      <div class="mobile-menu" id="mobile-menu" hidden>
        <nav aria-label="Mobile">
          <ul>
            {nav.filter((n) => n.href !== '/contact/').map((n, i) => (
              <li style={`--i:${i}`}><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="mobile-menu-foot">
          <a class="btn primary mobile-contact" href="/contact/">Contact me <span class="arrow" aria-hidden="true">→</span></a>
          <p class="mono muted"><a href={SITE.linkedin} rel="me noopener">LinkedIn</a> · <a href={SITE.x} rel="me noopener">X</a>{SITE.github && <> · <a href={SITE.github} rel="me noopener">GitHub</a></>} · <a href={`mailto:${SITE.email}`}>Email</a></p>
        </div>
      </div>
    </header>
    <button class="theme-toggle" type="button" aria-label="Toggle light and dark theme">
      <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="big" aria-hidden="true"><svg class="big-mark" viewBox="0 0 64 64"><defs><linearGradient id="fm1" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#3de8ff"/><stop offset="1" stop-color="#2f7bff"/></linearGradient><linearGradient id="fm2" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#c46bff"/><stop offset="1" stop-color="#7a5cff"/></linearGradient></defs><path d="M14 54 29 10" stroke="url(#fm1)" stroke-width="12" stroke-linecap="round" fill="none"/><path d="M35 54 50 10" stroke="url(#fm2)" stroke-width="12" stroke-linecap="round" fill="none"/></svg>igorbencheci<span class="tld">.dev</span></div>
        <span>© {new Date().getFullYear()} {SITE.name} · Built with Astro and hand-written CSS.</span>
        <span>
          <a href={`mailto:${SITE.email}`}>Email</a> · <a href={SITE.linkedin} rel="me">LinkedIn</a> · <a href={SITE.x} rel="me">X</a>
          {SITE.github && <> · <a href={SITE.github} rel="me">GitHub</a></>} · <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </footer>
    <!-- Google Tag Manager / GA4 (Delayed for Core Web Vitals) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      function loadGTM() {
        if (window._gtmLoaded) return;
        window._gtmLoaded = true;

        ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function(evt) {
          window.removeEventListener(evt, loadGTM, { passive: true });
        });

        var s = document.createElement('script');
        s.async = true;
        s.fetchPriority = 'low';
        s.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-MV3HW43W';
        document.head.appendChild(s);
      }

      ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function(evt) {
        window.addEventListener(evt, loadGTM, { once: true, passive: true });
      });

      if ('requestIdleCallback' in window) {
        requestIdleCallback(function() { setTimeout(loadGTM, 3500); });
      } else {
        window.addEventListener('load', function() { setTimeout(loadGTM, 3500); });
      }
    </script>
    <script>import '../scripts/motion';</script>
  </body>
</html>
